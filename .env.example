# PostgreSQL Database
DATABASE_URL=postgresql://gatewayops:gatewayops_secret@localhost:5432/gatewayops

# Redis Cache
REDIS_URL=redis://localhost:6379

# API Server
PORT=4000
NODE_ENV=production

# Security
JWT_SECRET=super_secret_jwt_key_change_in_prod

# Database Setup (migrations and seeds run via SQL init, not Knex)
RUN_MIGRATIONS=false
RUN_SEEDS=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://api:4000
